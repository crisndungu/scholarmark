# ═══════════════════════════════════════════════════════════
#  ScholarMark — Environment Variables
#  Copy this file to .env and fill in your actual values
#  NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# ─── ANTHROPIC ───────────────────────────────────────────────
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── PAYSTACK ────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYSTACK_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── SECURITY ────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# ─── DATABASE ────────────────────────────────────────────────
# Path to SQLite database file
DB_PATH=./data/scholarmark.db

# ─── FRONTEND URL (for CORS) ─────────────────────────────────
# In production, set this to your actual domain
FRONTEND_URL=http://localhost:3000

# ─── OPTIONAL: Exchange rate API ─────────────────────────────
# Free tier: https://exchangeratesapi.io or https://openexchangerates.org
# If left blank, app uses hardcoded fallback rates
EXCHANGE_RATE_API_KEY=
